# Release packaging output (scripts/package.sh). Reproducible; never committed.
dist/

# Repo-local tool cache (scripts/toolcache.sh).
#
# The restore artefacts — the AArch64 cross toolchain tarball, its host-side
# binutils runtime libraries, and static qemu-aarch64 — are COMMITTED so a fresh
# clone can restore a full, working toolchain offline. Everything else the cache
# may hold is large and machine-specific and is ignored.
tools/cache/*
!tools/cache/toolchain/
!tools/cache/bin/
tools/cache/bin/*
!tools/cache/bin/qemu-aarch64-static

# UML feasibility experiments (large, regenerable via experiments/uml/run.sh)
.uml-rootfs/
.uml-tmp/
*.img
wget-log*
