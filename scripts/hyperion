#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# Project HYPERION - the `hyperion` command.
set -euo pipefail

SELF="${BASH_SOURCE[0]}"
while [ -L "${SELF}" ]; do
    target="$(readlink "${SELF}")"
    case "${target}" in
        /*) SELF="${target}" ;;
        *)  SELF="$(dirname "${SELF}")/${target}" ;;
    esac
done
BIN_DIR="$(cd "$(dirname "${SELF}")" && pwd)"
PREFIX="$(cd "${BIN_DIR}/.." && pwd)"

CONF="${HYPERION_INSTALL_CONF:-${PREFIX}/share/hyperion/install.conf}"

if [ -n "${HYPERION_SRC:-}" ]; then
    SRC="${HYPERION_SRC}"
elif [ -f "${CONF}" ]; then
    SRC="$(sed -n 's/^HYPERION_SRC=//p' "${CONF}" | head -1)"
else
    SRC="$(cd "${BIN_DIR}/.." && pwd)"
fi

if [ -n "${HYPERION_BUILD_DIR:-}" ]; then
    BUILD="${HYPERION_BUILD_DIR}"
elif [ -f "${CONF}" ]; then
    BUILD="${sed_build:-$(sed -n 's/^HYPERION_BUILD_DIR=//p' "${CONF}" | head -1)}"
else
    BUILD="${SRC}/build/dev"
fi

if [ -x "${SRC}/scripts/toolcache.sh" ]; then
    eval "$("${SRC}/scripts/toolcache.sh" env)"
fi

BENCH_BIN="${BUILD}/benchmarks/hyperion_bench"

say() { printf '%s\n' "$*"; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }

need_checkout() {
    [ -d "${SRC}" ] || die "source checkout not found at '${SRC}' (re-run install.sh)"
}

need_build() {
    need_checkout
    [ -d "${BUILD}" ] || die "no build tree at '${BUILD}' (run: hyperion build)"
}

need_bench() {
    need_build
    [ -x "${BENCH_BIN}" ] || die "benchmark harness not built (run: hyperion build)"
}

cmd_help() {
    cat <<'EOF'
hyperion - x86-64 -> AArch64 user-mode dynamic binary translator

usage: hyperion <command> [options]

status
  status        what is implemented, and what is not
  doctor        check the host, toolchain and install
  version       print version and build information
  probe         report host capabilities (arch, kernel, W^X, page size)

build and test
  build         build the project (Release)
  test          run the test suite
  bench         run the benchmark harness
  cross-test    build and run the AArch64 tests under qemu-user (if available)
  package       build static release tarballs into dist/
  clean         remove this install's build tree

paths
  src           print the source checkout path
  build-dir     print the build tree path

translator
  run <file>    execute a raw x86-64 code blob or static/dynamic ELF64 executable
  info <elf>    describe an ELF64 executable (read-only)

syscall registry (the persistent compatibility rules)
  syscall-registry --list            which rules are active, and from where
  syscall-registry --validate        check the file; never modifies it
  syscall-registry --write           create the default registry if absent
  syscall-registry --export-defaults print the shipped rules as JSON
  syscall-registry --json            machine-readable summary
  --registry=FILE                   use FILE instead of the default path
                                    (default: $XDG_DATA_HOME/hyperion/syscalls/registry.json,
                                     else $HOME/.local/share/hyperion/syscalls/registry.json)
  HYPERION_SYSCALL_REGISTRY=FILE    the same, for every invocation
  HYPERION_NO_SYSCALL_REGISTRY=1    ignore the file; use only the built-in rules

  help          show this message
EOF
}

cmd_version() {
    if [ -x "${BUILD}/hyperion" ]; then
        "${BUILD}/hyperion" version
    fi
    say "source: ${SRC}"
    say "build:  ${BUILD}"
}

# `probe` is implemented by the binary but was missing from this dispatcher, so
# `hyperion probe` printed "unknown command" even though `hyperion version`
# worked. Delegate rather than reimplement.
cmd_probe() {
    need_build
    local bin="${BUILD}/hyperion"
    [ -x "${bin}" ] || die "hyperion binary not found at '${bin}' (run: hyperion build)"
    exec "${bin}" probe
}

cmd_status() {
    cat <<'EOF'
Project HYPERION - status

IMPLEMENTED
  - CMake build, CI, unit tests, cross tests, sanitizers, static tarballs ('hyperion package')
  - baseline x86-64 + 128-bit SSE2 decoder and reference interpreter (Tier 0).
    Throughput is host- and workload-dependent and is not claimed here: measure
    it with 'hyperion_tier_bench' on your own device rather than trusting a
    number from somebody else's hardware.
  - user-mode AArch64 + 128-bit ARMv8 NEON + IBTC dynamic binary translator
    (Tier 1). 'User-mode' is meant literally: this is not a full-system or
    kernel-level emulator, and it does not run privileged guests.
  - static ET_EXEC / static-PIE ET_DYN AND dynamically linked PT_INTERP (ld-linux-x86-64.so.2)
    ELF64 execution with file-backed mmap, MAP_FIXED, and --sysroot support
  - Linux x86-64 user-space syscall translation layer: 128 of 375 syscall numbers
    answered (127 implemented, 1 stubbed), counted from docs/syscalls/inventory.tsv
    by tools/gen_syscall_inventory.py --check so the number cannot drift
  - multi-layer syscall dispatch (compiled rule table -> static switch -> legacy
    compat switch -> ENOSYS), 40 ABI adapters translating x86-64/AArch64
    structure-layout differences (packed epoll_event, pollfd, fd_set, rusage,
    timespec, ...), and a persistent validated JSON registry outside the install
    directory ('hyperion syscall-registry --list')
  - process creation: fork(2), vfork(2), the process-creating subset of clone(2),
    execve(2) and wait4(2), with fd inheritance, close-on-exec and pipes, so
    shell pipelines and programs that spawn subprocesses run
    (verified against a static x86-64 BusyBox: `sh -c 'printf "9\n2\n" | sort -n'`)

LIMITATIONS
  - no thread creation: CLONE_VM / CLONE_THREAD / CLONE_FILES / CLONE_FS /
    CLONE_SIGHAND return ENOSYS rather than being silently downgraded to a fork,
    because a guest that asked for a shared address space would corrupt its own
    memory if it quietly received a private copy. Multi-threaded guests do not run.
  - a forked child runs on the Tier 0 interpreter by default; the parent keeps
    whichever tier it was using
  - namespace-creating clone flags return ENOSYS (they need CAP_SYS_ADMIN, which
    unrooted Android does not grant)
  - no sockets, no inotify/signalfd, no file-backed mmap, no waitid
  - ioctl covers TCGETS/TCSETS/TCSETSW/TCSETSF, TIOCGWINSZ/TIOCSWINSZ and
    FIONREAD (enough for terminal raw mode); other device requests are ENOTTY
  - rt_sigaction/sigaltstack record and report the guest's dispositions and
    alternate stack, but no signal is ever delivered to a guest handler
  - madvise implements MADV_DONTNEED (really zeroes) and the pure hints;
    fork-affecting advice returns ENOSYS. prctl covers name/pdeathsig/dumpable
    (recorded), timerslack and no_new_privs (forwarded), and refuses seccomp/MM/
    capabilities with ENOSYS
  - futex compares the value, honours a relative timeout (ETIMEDOUT) and refuses
    to block without one (ENOSYS): a guest thread cannot exist, so no waiter
    could ever be woken; it is the one entry still listed as 'stubbed'
  - no AVX2 / AVX-512 yet
  - Android: the app seccomp policy answers syscalls outside its allowlist with
    SIGSYS (SECCOMP_RET_TRAP), which is fatal. Before API 30 that list has no
    statx(2) and no memfd_create(2), so HYPERION synthesizes statx from
    fstatat(2) and emulates memfd_create with O_TMPFILE there instead of issuing
    them ('hyperion probe' says which path is in use)
EOF
}

cmd_doctor() {
    say "Project HYPERION - environment check"
    say ""
    say "install"
    say "  prefix      : ${PREFIX}"
    say "  config      : ${CONF} $( [ -f "${CONF}" ] && echo '(found)' || echo '(not found)' )"
    say "  source      : ${SRC} $( [ -d "${SRC}" ] && echo '(found)' || echo '(MISSING)' )"
    say "  build tree  : ${BUILD} $( [ -d "${BUILD}" ] && echo '(found)' || echo '(not built)' )"
    say ""
    say "host"
    say "  os          : $(uname -s) $(uname -r)"
    say "  arch        : $(uname -m)"
    say ""
    say "toolchain"
    for t in cmake ninja c++ g++ clang++ aarch64-linux-gnu-g++ qemu-aarch64 qemu-aarch64-static git; do
        if command -v "$t" >/dev/null 2>&1; then
            say "  $(printf '%-22s' "${t}") $(command -v "$t")"
        else
            say "  $(printf '%-22s' "${t}") (not found)"
        fi
    done
}

cmd_build() {
    need_checkout
    say "Configuring ${BUILD} (Release)"
    cmake -S "${SRC}" -B "${BUILD}" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release -DHYPERION_WARNINGS_AS_ERRORS=ON >/dev/null
    say "Building"
    cmake --build "${BUILD}"
    say "Build complete."
}

cmd_test() {
    need_build
    ctest --test-dir "${BUILD}" --output-on-failure
}

cmd_bench() {
    need_bench
    exec "${BENCH_BIN}" "$@"
}

cmd_cross_test() {
    exec "${SRC}/scripts/dev.sh" cross-test
}

cmd_package() {
    need_checkout
    [ -x "${SRC}/scripts/package.sh" ] || die "scripts/package.sh not found in ${SRC}"
    exec "${SRC}/scripts/package.sh" "$@"
}

cmd_clean() {
    need_checkout
    say "Removing ${BUILD}"
    rm -rf "${BUILD}"
}

cmd_run() {
    need_build
    local bin="${BUILD}/hyperion"
    [ -x "${bin}" ] || die "hyperion binary not found at '${bin}' (run: hyperion build)"
    exec "${bin}" run "$@"
}

cmd_info() {
    need_build
    local bin="${BUILD}/hyperion"
    [ -x "${bin}" ] || die "hyperion binary not found at '${bin}' (run: hyperion build)"
    exec "${bin}" info "$@"
}

# The registry commands are implemented by the binary. Delegating keeps a single
# implementation: the wrapper never parses or edits the JSON itself.
cmd_syscall_registry() {
    need_build
    local bin="${BUILD}/hyperion"
    [ -x "${bin}" ] || die "hyperion binary not found at '${bin}' (run: hyperion build)"
    exec "${bin}" syscall-registry "$@"
}

case "${1:-}" in
    ""|-h|--help|help)  cmd_help ;;
    status)             cmd_status ;;
    version)            cmd_version ;;
    probe)              cmd_probe ;;
    doctor)             cmd_doctor ;;
    build)              cmd_build ;;
    test)               cmd_test ;;
    bench)              shift; cmd_bench "$@" ;;
    cross-test)         cmd_cross_test ;;
    package)            shift; cmd_package "$@" ;;
    clean)              cmd_clean ;;
    src)                say "${SRC}" ;;
    build-dir)          say "${BUILD}" ;;
    run)                shift; cmd_run "$@" ;;
    info)               shift; cmd_info "$@" ;;
    syscall-registry)   shift; cmd_syscall_registry "$@" ;;
    *)                  printf 'error: unknown command %s\n\n' "$1" >&2; cmd_help >&2; exit 1 ;;
esac
